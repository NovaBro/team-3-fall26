option_settings:
  aws:elasticbeanstalk:application:environment:
    DJANGO_SETTINGS_MODULE: nycfood.settings
    DJANGO_DEBUG: "False"
    DJANGO_ALLOWED_HOSTS: ".elasticbeanstalk.com"
    EMAIL_BACKEND: django.core.mail.backends.smtp.EmailBackend
  aws:elasticbeanstalk:container:python:
    WSGIPath: nycfood.wsgi:application
  aws:elasticbeanstalk:environment:proxy:staticfiles:
    /static: staticfiles
    /media: media

container_commands:
  # community first: its 0011 reads restaurant data that search/0008 (default)
  # deletes.
  01_migrate_community:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --database=community --noinput"
    leader_only: true
  02_migrate_users:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --database=users --noinput"
    leader_only: true
  # First deploy after the users.db split: copy accounts out of nyc_food.db.
  # Refuses (harmlessly) once users.db already has accounts.
  02b_move_accounts:
    command: "source /var/app/venv/*/bin/activate && python manage.py move_accounts_db || true"
    leader_only: true
  02c_migrate:
    command: "source /var/app/venv/*/bin/activate && python manage.py migrate --noinput"
    leader_only: true
  03_create_admin:
    command: "source /var/app/venv/*/bin/activate && python manage.py createsuperuser --noinput || true"
    leader_only: true
  04_collectstatic:
    command: "source /var/app/venv/*/bin/activate && python manage.py collectstatic --noinput"
